# Frontend configuration template.
# Copy this file to `.env` and adjust values for your environment.
# Configuration names only - never commit real credentials/keys/tokens/private URLs.

# Base URL of the CyberAgent backend API that this frontend talks to.
# NOTE: the default in src/api.ts is http://127.0.0.1:8001, but in this
# environment host ports 8000/8001 are occupied by unrelated services
# (Docker Desktop), so the CyberAgent backend is run on 8003 and the
# frontend is pointed at it via VITE_API_URL as shown below.
VITE_API_URL=http://127.0.0.1:8003