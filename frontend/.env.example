# Frontend configuration template.
# Copy this file to `.env` and adjust values for your environment.
# Configuration names only - never commit real credentials/keys/tokens/private URLs.

# Base URL of the CyberAgent backend API that this frontend talks to.
# Note: the local VM convention here is 127.0.0.1:8001 because host port 8000
# is occupied by an unrelated service running in this environment.
VITE_API_URL=http://127.0.0.1:8001